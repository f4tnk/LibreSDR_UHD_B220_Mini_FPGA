add_cells_to_pblock [get_pblocks  {CLKAG_u_libresdr_b210_io/rx_clk_bufr}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL && NAME!=u_libresdr_b210_io/BUFGMUX_inst} -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="u_libresdr_b210_io/rx_clk_bufr"}]]]
resize_pblock [get_pblocks {CLKAG_u_libresdr_b210_io/rx_clk_bufr}] -add {CLOCKREGION_X0Y3:CLOCKREGION_X0Y3}
#endgroup

